# 64-bit build flags

UNAME_PROC := $(shell uname -i)

ifndef BITS
  ifeq ($(UNAME_PROC),i386)
    BITS := 32
  else
    BITS := 64
  endif
endif

ifeq ($(UNAME_PROC),ppc64)
  ifeq ($(BITS),64)
    CXXFLAGS += -m64
    LDFLAGS += -m64
  endif
endif
ifeq ($(UNAME_PROC),x86_64)
  ifeq ($(BITS),32)
    CXXFLAGS += -m32
    LDFLAGS += -m32
  endif
endif


# define installation directories
tld=utility
install_base_dir=$(DPM_INSTALL_DIR)/$(tld)
include_install_dir=$(install_base_dir)/include
etc_install_dir=$(DPM_INSTALL_DIR)/etc
DPM_LIB_INSTALL_DIR=$(install_base_dir)/lib
DPM_BIN_INSTALL_DIR=$(install_base_dir)/bin
DPM_SBIN_INSTALL_DIR=$(install_base_dir)/sbin

# include flags
CXXFLAGS    += -isystem $(DPM_BUILD_DIR)/
CXXFLAGS    += -isystem $(DPM_BUILD_DIR)/
CXXFLAGS    += -isystem $(DPM_BUILD_DIR)/utility/include

# standard flag
CXXFLAGS    += -std=c++20

# debugger flags
ifneq ($(DEBUG_FLAGS),no)
CXXFLAGS    += $(DEBUG_FLAGS)
endif
